# Copy to .env before `docker compose up`.

# Where people reach the portal. Used in the install command shown in the UI,
# in /install.sh, and in the device-link URL the CLI prints.
SHKILLS_PUBLIC_URL=https://shkills.yourcompany.com

# Generate with: openssl rand -hex 48
# Keep it stable — changing it invalidates every browser session.
SHKILLS_JWT_SECRET=

# Optional. Lets the git mirror write the company skills into a repository, so
# they are not only in this server's database. A fine-grained token with
# `contents: write` on that one repository is the right shape.
# Which repository is chosen in the portal, on the People page — not here.
SHKILLS_GITHUB_TOKEN=
