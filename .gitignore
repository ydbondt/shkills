node_modules/
dist/
*.log

# A global ignore excludes **/.claude on some machines. The skills below are
# meant to travel with the repo, so carve exactly them back in — and nothing
# else under .claude, which is per-machine.
!.claude/
.claude/*
!.claude/skills/

.env
.env.local
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.DS_Store
coverage/
packages/server/public/

# This repo is public, and the cluster secrets are created out-of-band
# (deploy/k8s/README.md). Belt and braces so a rendered manifest or a stray
# kubeconfig cannot be committed by accident.
*.kubeconfig
kubeconfig*
deploy/k8s/*secret*.yaml
!deploy/k8s/60-runner.yaml

# Cucumber HTML reports from the acceptance suite
packages/e2e/reports/
