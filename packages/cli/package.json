{
  "name": "@shkills/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "shkills": "dist/shkills.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/shkills.js --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/shkills.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
