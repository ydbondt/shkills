{
  "name": "@shkills/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "shkills": "dist/shkills.mjs"
  },
  "scripts": {
    "//": "The bundle is ESM, so it must end in .mjs — it gets installed into a directory with no package.json, where Node would otherwise parse .js as CommonJS.",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/shkills.mjs --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/shkills.mjs",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
